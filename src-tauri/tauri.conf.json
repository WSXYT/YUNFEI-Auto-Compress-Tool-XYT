{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YUNFEI-Auto-Compress",
  "version": "1.0.251",
  "identifier": "com.yunfei.subtitle-compress",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YUNFEI自动压缩_1.0.2.51",
        "width": 960,
        "height": 760,
        "minWidth": 920,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "YUNFEI自动压缩"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "notification": {
      "enabled": true
    },
    "autostart": {
      "enabled": true
    }
  }
}
